# Copy to .env and adjust as needed. .env is gitignored.

APP_NAME=App
LOG_LEVEL=INFO

# Any SQLAlchemy-supported URL, e.g. postgresql+psycopg://user:pass@localhost/app
DATABASE_URL=sqlite:///./app.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Which ChatProvider adapter get_chat_provider() builds. Only "openai" exists in v1.
PROVIDER=openai

# Required — the app does not boot without it. Never commit a real key.
OPENAI_API_KEY=sk-placeholder

OPENAI_MODEL=gpt-5.6-terra
OPENAI_TITLE_MODEL=gpt-5.6-luna
SYSTEM_PROMPT="You are a helpful, concise assistant."
MAX_TOKENS=1024

# Recorded in request_params/config_hash; never sent to the OpenAI API.
TEMPERATURE=1.0

PROVIDER_TIMEOUT_SECONDS=60

# Where the logging SDK posts inference log events (spec 006). Points at
# this same app's /ingest/logs endpoint by default.
INGEST_URL=http://localhost:8000/ingest/logs
INGEST_TIMEOUT_SECONDS=5.0

# Transport the logging SDK publishes InferenceLogEvents over (spec 017).
# "http" (default) POSTs to INGEST_URL above — no broker needed, behavior
# unchanged. "kafka" produces to KAFKA_TOPIC instead; requires a broker
# running locally and the in-app (or standalone) consumer to ingest it.
# See README.md "Kafka event pipeline (local dev)" for setup.
EVENT_TRANSPORT=http

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=inference-logs
KAFKA_CONSUMER_GROUP=ingestion
KAFKA_CONSUMER_MAX_RECORDS=100
KAFKA_CONSUMER_BATCH_TIMEOUT_MS=1000

# Engine behind GET /logs/stats and GET /logs/timeseries (spec 018).
# "auto" (default): DuckDB when DATABASE_URL is a file-based SQLite URL,
# else the SQLAlchemy path. "sqlite": force the SQLAlchemy path (kill
# switch). "duckdb": force DuckDB — errors loudly if DATABASE_URL isn't a
# file-based SQLite URL.
# ANALYTICS_ENGINE=auto
